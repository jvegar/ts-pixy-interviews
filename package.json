{
  "name": "monorepo",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "affected:deploy": "lerna run --since HEAD^ deploy",
    "affected:test": "lerna run --since HEAD^ test",
    "affected:list": "lerna ls --since HEAD^ -a",
    "new": "hygen",
    "branch": "hygen branch",
    "start": "lerna exec sls offline --scope",
    "test": "jest -c configs/jest.config.js",
    "lint": "eslint",
    "lint:fix": "eslint --cache --cache-location .cache/ --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --cache --cache-location .cache/ --fix",
    "*.{js,ts,md,json}": "prettier --write"
  },
  "devDependencies": {
    "@babel/core": "^7.12.3",
    "@babel/preset-env": "^7.12.1",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^11.0.0",
    "@types/aws-lambda": "^8.10.64",
    "@types/jest": "^26.0.15",
    "@types/node": "^14.14.7",
    "@types/serverless": "^1.78.8",
    "@typescript-eslint/eslint-plugin": "^4.5.0",
    "@typescript-eslint/parser": "^4.5.0",
    "babel-loader": "^8.1.0",
    "core-js": "^3.6.5",
    "eslint": "^7.11.0",
    "fork-ts-checker-webpack-plugin": "^5.2.0",
    "husky": "^4.3.0",
    "hygen": "^6.0.4",
    "jest": "^29.7.0",
    "lerna": "^8.1.9",
    "lint-staged": "^10.4.2",
    "prettier": "^2.1.2",
    "serverless": "^4.5.4",
    "serverless-offline": "^14.4.0",
    "serverless-webpack": "^5.3.5",
    "ts-jest": "^29.2.5",
    "ts-loader": "^8.0.6",
    "tsconfig-paths-webpack-plugin": "^3.3.0",
    "typescript": "^4.0.3",
    "webpack": "^5.2.0",
    "webpack-node-externals": "^2.5.2"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "serverless-http": "^2.6.1",
    "twitter": "1.1.0",
    "uuid": "^8.3.2"
  }
}
