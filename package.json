{
  "name": "monorepo",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "affected:deploy": "lerna run --since HEAD^ deploy",
    "affected:test": "lerna run --since HEAD^ test",
    "affected:list": "lerna ls --since HEAD^ -a",
    "new": "hygen",
    "branch": "hygen branch",
    "start": "lerna exec sls offline --scope",
    "test": "jest -c configs/jest.config.js",
    "lint": "eslint",
    "lint:fix": "eslint --cache --cache-location .cache/ --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --cache --cache-location .cache/ --fix",
    "*.{js,ts,md,json}": "prettier --write"
  },
  "devDependencies": {
    "@babel/core": "^7.12.3",
    "@babel/preset-env": "^7.12.1",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^11.0.0",
    "@types/aws-lambda": "^8.10.64",
    "@types/jest": "^26.0.15",
    "@types/node": "^14.14.7",
    "@types/serverless": "^1.78.8",
    "@typescript-eslint/eslint-plugin": "^4.5.0",
    "@typescript-eslint/parser": "^4.5.0",
    "babel-loader": "^8.1.0",
    "core-js": "^3.6.5",
    "eslint": "^7.11.0",
    "fork-ts-checker-webpack-plugin": "^5.2.0",
    "husky": "^4.3.0",
    "hygen": "^6.0.4",
    "jest": "^29.7.0",
    "lerna": "^8.1.9",
    "lint-staged": "^10.4.2",
    "prettier": "^2.1.2",
    "serverless": "^4.5.4",
    "serverless-offline": "^14.4.0",
    "serverless-webpack": "^5.3.5",
    "ts-jest": "^29.2.5",
    "ts-loader": "^8.0.6",
    "tsconfig-paths-webpack-plugin": "^3.3.0",
    "typescript": "^4.0.3",
    "webpack": "^5.104.1",
    "webpack-node-externals": "^2.5.2"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.0",
    "@aws-sdk/core": "^3.850.0",
    "@aws-sdk/middleware-user-agent": "^3.850.0",
    "@aws-sdk/util-user-agent-node": "^3.850.0",
    "@aws-sdk/nested-clients": "^3.850.0",
    "tar": "^7.5.0",
    "minimatch": "^9.0.7",
    "brace-expansion": "^2.0.3",
    "js-yaml": "^4.1.0",
    "node-gyp": "^11.2.0",
    "make-fetch-happen": "^14.0.2",
    "cacache": "^19.0.1",
    "serialize-javascript": "^7.0.5",
    "terser-webpack-plugin": "^5.3.17",
    "path-to-regexp": "^0.1.13",
    "qs": "^6.14.2",
    "body-parser": "^1.20.4",
    "axios": "^1.15.0",
    "node-fetch": "^2.7.0",
    "flatted": "^3.4.2",
    "picomatch": "^2.3.2",
    "diff": "^4.0.4",
    "node-forge": "^1.3.4",
    "handlebars": "^4.7.9",
    "lodash": "^4.17.24",
    "follow-redirects": "^1.15.12",
    "uuid": "^14.0.0",
    "ajv": "^8.18.0",
    "@eslint/eslintrc": {
      "ajv": "^6.14.0"
    },
    "yaml": "^2.8.3",
    "semver": "^7.7.2",
    "cross-spawn": "^7.0.6",
    "micromatch": "^4.0.8",
    "ejs": "^3.1.10",
    "inquirer-autocomplete-standalone": "^0.8.1",
    "luxon": "^3.6.1",
    "@smithy/middleware-retry": "^4.3.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "serverless-http": "^2.6.1",
    "twitter": "1.1.0",
    "uuid": "^14.0.0",
    "aws-sdk": "^2.1692.0"
  }
}
